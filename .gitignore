# Build artifacts
/bin/
/dist/
# The built binary at the repo root, not the cmd/wifitest/ source directory.
/wifitest
/wifitest.exe

# Local configuration and history — may contain credentials (webhook URLs).
# Never commit these.
config.json
config.toml
*.local.json
*.local.toml
history.jsonl

# Tauri desktop build artefacts. The sidecar is the engine compiled from the
# source already in this repository, so committing it would store the same
# program twice — once as source, once as seven megabytes of binary.
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/binaries/

# Go
*.test
*.out
vendor/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Tooling artefacts that are not project content
.semgrep/
